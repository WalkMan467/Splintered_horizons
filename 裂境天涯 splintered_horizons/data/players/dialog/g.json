  "pause": false,
  "after_action": "none",
  "actions": [
    {
      "label": {
        "translate": "dialog.main.quick_actions.reduce_particles",
        "fallback": "Reduce Particles",
        "color": "white"
      },
      "action": {
        "type": "run_command",
        "command": "trigger player.setting.reduce_particles.trigger"
      }
    },
    {
      "label": {
        "translate": "dialog.main.quick_actions.campfire_darkness",
        "fallback": "Campfire Darkness",
        "color": "white"
      },
      "action": {
        "type": "run_command",
        "command": "trigger player.setting.campfire_darkness.trigger"
      }
    },
    {
      "label": {
        "translate": "dialog.main.quick_actions.backup",
        "fallback": "Data Backup",
        "color": "white"
      },
      "action": {
        "type": "run_command",
        "command": "trigger player.setting.backup.trigger"
      }
    },
    {
      "label": {
        "translate": "dialog.main.quick_actions.backup.return",
        "fallback": "Data Backup Return",
        "color": "white"
      },
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": "players:backup_return"
      }
